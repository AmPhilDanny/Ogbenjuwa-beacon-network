{
  "name": "ogbenjuwa-citizen-android",
  "displayName": "Ogbenjuwa",
  "version": "1.0.0",
  "description": "Ogbenjuwa Community Safety Network - citizen portal Android app (Cordova wrapper around the static user_app)",
  "license": "MIT",
  "scripts": {
    "cordova:prepare": "node scripts/ensure-www.js && cordova prepare",
    "cordova:build": "node scripts/ensure-www.js && cordova build android",
    "cordova:run": "node scripts/ensure-www.js && cordova run android"
  },
  "devDependencies": {
    "@havesource/cordova-plugin-push": "^7.0.0",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-plugin-advanced-http": "^3.3.1",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-geolocation": "^5.0.0",
    "cordova-plugin-inappbrowser": "^7.0.0",
    "cordova-plugin-media-capture": "^6.0.0",
    "cordova-plugin-network-information": "^3.1.0",
    "cordova-plugin-splashscreen": "^6.0.1",
    "cordova-plugin-statusbar": "^4.0.0",
    "cordova-plugin-vibration": "^3.1.1"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-media-capture": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-device": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-vibration": {},
      "cordova-plugin-splashscreen": {},
      "cordova-plugin-statusbar": {},
      "cordova-plugin-inappbrowser": {},
      "cordova-plugin-advanced-http": {
        "ANDROIDBLACKLISTSECURESOCKETPROTOCOLS": "SSLv3,TLSv1"
      },
      "@havesource/cordova-plugin-push": {
        "ANDROID_DEFAULT_NOTIFICATION_CHANNEL_ID": "default",
        "ANDROIDX_CORE_VERSION": "1.16.0",
        "FCM_VERSION": "24.1.0"
      }
    }
  }
}
